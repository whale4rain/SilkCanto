{
  "name": "silkcanto",
  "version": "0.1.0",
  "description": "SilkCanto (锦章) - State-driven batch web-novel production CLI engine",
  "type": "module",
  "bin": {
    "silkcanto": "./dist/cli.js"
  },
  "scripts": {
    "silkcanto": "node --use-env-proxy --import tsx src/cli.ts",
    "dev": "node --use-env-proxy --import tsx src/cli.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^1.0.0",
    "ai": "^5.0.0",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "dotenv": "^16.5.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.7.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
