# DeepSeek / Gemini / OpenAI-compatible API Configuration
SILKCANTO_API_KEY=your_api_key_here
# DeepSeek: https://api.deepseek.com/v1
# Gemini AI Studio: https://generativelanguage.googleapis.com/v1beta/openai/
SILKCANTO_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Default model (e.g., gemini-3.8-flash, gemini-4-hydrogen, ds-pro)
SILKCANTO_DEFAULT_MODEL=gemini-3.8-flash

# Optional per-stage model overrides (falls back to SILKCANTO_DEFAULT_MODEL)
SILKCANTO_MODEL_DECONSTRUCT=
SILKCANTO_MODEL_FOUNDATION=
SILKCANTO_MODEL_BEAT=
SILKCANTO_MODEL_DRAFT=
SILKCANTO_MODEL_DESLOP=
SILKCANTO_MODEL_CRITIC=
SILKCANTO_MODEL_COMMIT=

# Optional cost estimation (CNY per 1M tokens)
SILKCANTO_INPUT_COST_PER_1M=2.0
SILKCANTO_OUTPUT_COST_PER_1M=8.0

# Workspace root (defaults to ./workspace)
SILKCANTO_WORKSPACE_DIR=./workspace
